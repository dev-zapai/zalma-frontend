# Dev server port — marketing runs on 3000, grooming on 3001
PORT=3001

# Supabase (Phase 1 — will move to backend-mediated auth in Phase 2)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Backend (backend-grooming service)
REACT_APP_BACKEND_URL=http://localhost:8001

# Cross-service URLs for footer "More from Zap AI" links.
# In production these become path-based URLs on the same origin.
REACT_APP_MARKETING_URL=http://localhost:3000
REACT_APP_PET_CLINIC_URL=http://localhost:3002/pet-clinic
REACT_APP_HUMAN_CLINIC_URL=http://localhost:3003/human-clinic
