# Production build settings (committed; non-secret).
# Real REACT_APP_* values come from GitHub Actions repo secrets at build time.

# Don't ship source maps to prod — they'd let anyone read the entire React
# source from DevTools → Sources. CRA emits them by default; this disables it.
GENERATE_SOURCEMAP=false

# Tighter behavior for production builds: warnings stay warnings, not errors,
# but `console.log` etc. are kept (Sentry will eventually intercept).
INLINE_RUNTIME_CHUNK=false
